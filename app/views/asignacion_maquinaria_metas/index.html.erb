<% content_for :title, "Asignación de Metas a Maquinarias" %>

<div class="d-flex justify-content-between align-items-center mb-3">

  <h2 class="fw-semibold mb-0">
    Asignación de Metas a Maquinarias
  </h2>

  <%= link_to "Nueva Asignación",
              new_asignacion_maquinaria_meta_path,
              class: "btn btn-primary" %>

</div>

<% if notice.present? %>
  <div class="alert alert-success py-2">
    <%= notice %>
  </div>
<% end %>

<div class="card shadow-sm border-0">

  <div class="table-responsive">

    <table class="table table-hover align-middle mb-0">

      <thead class="table-dark">

        <tr>
          <th>Meta</th>
          <th>Maquinarias Asignadas</th>
          <th>Acciones</th>
        </tr>

      </thead>

      <tbody>

        <% @metas.each do |meta| %>

          <tr>

            <td>

              <span class="badge"
                    style="background-color:<%= meta.color %>; color:white;">

                <%= meta.nombre %>

              </span>

            </td>

            <td>

              <span class="badge bg-primary">

                <%= meta.maquinarias.count %>

              </span>

            </td>

            <td>

              <%= link_to "Modificar",
                          edit_asignacion_maquinaria_meta_path(meta.id),
                          class: "btn btn-warning btn-sm" %>

            </td>

          </tr>

        <% end %>

      </tbody>

    </table>

  </div>

</div>
