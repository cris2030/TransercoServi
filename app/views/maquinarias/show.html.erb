<% content_for :title, "Maquinaria" %>

<% if notice.present? %>

  <div class="alert alert-success py-2">
    <%= notice %>
  </div>

<% end %>

<div class="card shadow-sm border-0">

  <!-- HEADER -->

  <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">

    <div>

      <h5 class="mb-0">
        <%= @maquinaria.nombre %>
      </h5>

      <small class="text-light">
        Código: <%= @maquinaria.codigo %>
      </small>

    </div>

    <span class="badge bg-secondary fs-6">
      <%= @maquinaria.numero_serie %>
    </span>

  </div>

  <!-- BODY -->

  <div class="card-body">

    <div class="row g-3">

      <!-- INFORMACIÓN GENERAL -->

      <div class="col-md-6">

        <div class="p-3 border rounded bg-light h-100">

          <h6 class="text-muted mb-3">
            Información General
          </h6>

          <p class="mb-2">
            <strong>Nombre:</strong>
            <%= @maquinaria.nombre %>
          </p>

          <p class="mb-2">
            <strong>Código:</strong>
            <%= @maquinaria.codigo %>
          </p>

          <p class="mb-0">
            <strong>Número de Serie:</strong>
            <%= @maquinaria.numero_serie %>
          </p>

        </div>

      </div>

      <!-- INFORMACIÓN DE IDENTIFICACIÓN -->

      <div class="col-md-6">

        <div class="p-3 border rounded bg-light h-100">

          <h6 class="text-muted mb-3">
            Identificación
          </h6>

          <div class="mb-3">

            <span class="text-muted d-block">
              Código
            </span>

            <span class="badge bg-primary fs-6">
              <%= @maquinaria.codigo %>
            </span>

          </div>

          <div>

            <span class="text-muted d-block">
              Número de Serie
            </span>

            <span class="badge bg-secondary fs-6">
              <%= @maquinaria.numero_serie %>
            </span>

          </div>

        </div>

      </div>

    </div>

  </div>

</div>

<!-- ACCIONES -->

<div class="mt-3 d-flex gap-2">

  <%= link_to "Editar",
      edit_maquinaria_path(@maquinaria),
      class: "btn btn-warning" %>

  <%= link_to "Volver",
      maquinarias_path,
      class: "btn btn-secondary" %>

  <%= button_to "Eliminar",
      @maquinaria,
      method: :delete,
      class: "btn btn-danger",
      form: {
        data: {
          turbo_confirm: "¿Seguro que deseas eliminar esta maquinaria?"
        }
      } %>

</div>
