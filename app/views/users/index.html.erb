<h1>Usuarios</h1>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Email</th>
      <th>Creado</th>
      <th>Acciones</th>
    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.email %></td>
        <td><%= user.created_at.strftime("%d/%m/%Y") %></td>
        <td>
          <%= link_to "Editar", edit_user_path(user) %>

          <%= button_to "Eliminar",
                        user_path(user),
                        method: :delete,
                        data: {
                          turbo_confirm: "¿Seguro que quieres eliminar este usuario?"
                        } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
